# Copy this file to .env and change the values.

# Database password (any long random text; you never type it).
DB_PASSWORD=change-me-long-random-text

# First facilitator account, created at the first start when no account exists.
# Change the password after signing in ("My account").
ADMIN_EMAIL=facilitateur@example.org
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Facilitateur

# Port of the app on the server (http://<server-address>:8080).
HTTP_PORT=8080

# Days of daily backups kept in ./backups
BACKUP_KEEP_DAYS=30

# HTTPS with a domain name (docker compose --profile https up -d):
# DOMAIN=diagnostic.example.org
# TRUST_PROXY=1
# COOKIE_SECURE=1
